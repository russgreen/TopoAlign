<Window x:Class="TopoAlign.Views.CreateAlignmentView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:TopoAlign.ViewModels"
        xmlns:behaviours="clr-namespace:TopoAlign.Behaviours"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance {x:Type viewModels:CreateAlignmentViewModel}, IsDesignTimeCreatable=False}"
        Title="{Binding WindowTitle}"
        FontSize="12" FontFamily="Segoe UI Light"
        WindowStartupLocation="CenterScreen"
        SizeToContent="Height" Width="380"
        WindowStyle="ToolWindow" ResizeMode="NoResize">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.Resources>
            <Style TargetType="TextBlock">
                <Setter Property="Margin" Value="0,0,0,6"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style TargetType="TextBox">
                <Setter Property="Margin" Value="0,0,0,6"/>
                <Setter Property="Height" Value="20"/>
            </Style>
            <Style TargetType="ComboBox">
                <Setter Property="Margin" Value="0,0,0,6"/>
            </Style>
            <Style TargetType="CheckBox">
                <Setter Property="Margin" Value="0,0,0,6"/>
            </Style>
            <Style TargetType="Button">
                <Setter Property="Margin" Value="0,0,0,6"/>
                <Setter Property="Height" Value="25"/>
            </Style>
        </Grid.Resources>

        <TextBlock Grid.Row="0" Text="Alignment name"/>
        <TextBox Grid.Row="0" Grid.Column="1"
                 Text="{Binding AlignmentName, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Grid.Row="1" Text="Start station"/>
        <TextBox Grid.Row="1" Grid.Column="1" HorizontalContentAlignment="Right"
                 Text="{Binding StartStation, UpdateSourceTrigger=PropertyChanged}"
                 MaxLength="20" behaviours:TextBoxInput.RegularExpression="^-?[0-9]*[.,]?[0-9]*$"/>

        <TextBlock Grid.Row="2" Text="Units"/>
        <ComboBox Grid.Row="2" Grid.Column="1"
                  ItemsSource="{Binding DisplayUnits}"
                  DisplayMemberPath="Label"
                  SelectedValue="{Binding SelectedDisplayUnit, UpdateSourceTrigger=PropertyChanged}"/>

        <Button Grid.Row="3" Grid.ColumnSpan="2" Content="Pick lines/arcs"
                Command="{Binding PickLinesCommand}"/>

        <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Text="{Binding ChainStatus}" TextWrapping="Wrap"/>

        <CheckBox Grid.Row="5" Grid.ColumnSpan="2"
                  Content="Reverse direction"
                  IsChecked="{Binding ReverseDirection}"/>

        <CheckBox Grid.Row="6" Grid.ColumnSpan="2"
                  Content="Delete source lines after create"
                  IsChecked="{Binding DeleteSourceLines}"/>

        <Separator Grid.Row="7" Grid.ColumnSpan="2" Margin="0,2,0,8"/>

        <CheckBox Grid.Row="8" Grid.ColumnSpan="2"
                  Content="Drape profile on toposolid"
                  IsChecked="{Binding DrapeOnTopo}"/>

        <Button Grid.Row="9" Grid.ColumnSpan="2" Content="Pick toposolid"
                IsEnabled="{Binding DrapeOnTopo}"
                Command="{Binding PickToposolidCommand}"/>

        <TextBlock Grid.Row="10" Grid.ColumnSpan="2" Text="{Binding TopoStatus}" TextWrapping="Wrap"/>

        <Grid Grid.Row="11" Grid.ColumnSpan="2" IsEnabled="{Binding DrapeOnTopo}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Sample interval"/>
            <TextBox Grid.Row="0" Grid.Column="1" HorizontalContentAlignment="Right"
                     Text="{Binding SampleInterval, UpdateSourceTrigger=PropertyChanged}"
                     MaxLength="12" behaviours:TextBoxInput.RegularExpression="^[0-9]*[.,]?[0-9]*$"/>

            <TextBlock Grid.Row="1" Text="Vertical tolerance"/>
            <TextBox Grid.Row="1" Grid.Column="1" HorizontalContentAlignment="Right"
                     Text="{Binding VerticalTolerance, UpdateSourceTrigger=PropertyChanged}"
                     MaxLength="12" behaviours:TextBoxInput.RegularExpression="^[0-9]*[.,]?[0-9]*$"/>

            <TextBlock Grid.Row="2" Text="Elevation offset"/>
            <TextBox Grid.Row="2" Grid.Column="1" HorizontalContentAlignment="Right"
                     Text="{Binding ElevationOffset, UpdateSourceTrigger=PropertyChanged}"
                     MaxLength="12" behaviours:TextBoxInput.RegularExpression="^-?[0-9]*[.,]?[0-9]*$"/>

            <TextBlock Grid.Row="3" Text="Min vertical curve length"/>
            <TextBox Grid.Row="3" Grid.Column="1" HorizontalContentAlignment="Right"
                     Text="{Binding MinVerticalCurveLength, UpdateSourceTrigger=PropertyChanged}"
                     MaxLength="12" behaviours:TextBoxInput.RegularExpression="^[0-9]*[.,]?[0-9]*$"/>
        </Grid>

        <Button Grid.Row="12" Grid.ColumnSpan="2" Content="Preview profile"
                IsEnabled="{Binding DrapeOnTopo}"
                Command="{Binding PreviewProfileCommand}"/>

        <TextBlock Grid.Row="13" Grid.ColumnSpan="2" Text="{Binding ProfilePreview}" TextWrapping="Wrap"/>

        <Button Grid.Row="14" Grid.ColumnSpan="2" Content="Create Alignment" IsDefault="True" Height="30"
                Command="{Binding CreateAlignmentCommand}"/>
    </Grid>
</Window>
