<Window x:Class="TopoAlign.Views.SweepAlignmentView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:TopoAlign.ViewModels"
        xmlns:behaviours="clr-namespace:TopoAlign.Behaviours"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance {x:Type viewModels:SweepAlignmentViewModel}, IsDesignTimeCreatable=False}"
        Title="{Binding WindowTitle}"
        FontSize="12" FontFamily="Segoe UI Light"
        WindowStartupLocation="CenterScreen"
        SizeToContent="Height" Width="420"
        WindowStyle="ToolWindow" ResizeMode="NoResize">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.Resources>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
            <Style TargetType="TextBlock">
                <Setter Property="Margin" Value="0,0,0,6"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style TargetType="TextBox">
                <Setter Property="Margin" Value="0,0,0,6"/>
                <Setter Property="Height" Value="20"/>
            </Style>
            <Style TargetType="ComboBox">
                <Setter Property="Margin" Value="0,0,0,6"/>
            </Style>
            <Style TargetType="CheckBox">
                <Setter Property="Margin" Value="0,0,0,6"/>
            </Style>
            <Style TargetType="Button">
                <Setter Property="Margin" Value="0,0,0,6"/>
                <Setter Property="Height" Value="25"/>
            </Style>
        </Grid.Resources>

        <Button Grid.Row="0" Grid.ColumnSpan="2" Content="Pick alignment" Command="{Binding PickAlignmentCommand}"/>

        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding AlignmentStatus}" TextWrapping="Wrap"/>

        <TextBlock Grid.Row="2" Text="Sweep"/>
        <ComboBox Grid.Row="2" Grid.Column="1"
                  ItemsSource="{Binding Modes}"
                  DisplayMemberPath="Name"
                  SelectedItem="{Binding SelectedMode}"
                  ToolTip="Sweep one profile, or an assembly: several profiles (road, kerbs, footways) placed at offsets from the alignment, each made as its own element."/>

        <TextBlock Grid.Row="3" Text="Assembly" Visibility="{Binding IsAssemblyMode, Converter={StaticResource BoolToVisibility}}"/>
        <Grid Grid.Row="3" Grid.Column="1" Visibility="{Binding IsAssemblyMode, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ComboBox ItemsSource="{Binding Assemblies}"
                      DisplayMemberPath="Name"
                      SelectedItem="{Binding SelectedAssembly}"/>
            <Button Grid.Column="1" Content="Edit assemblies..." Margin="6,0,0,6" Padding="8,0"
                    Command="{Binding EditAssembliesCommand}"/>
        </Grid>

        <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Text="{Binding AssemblyStatus}" TextWrapping="Wrap"
                   Visibility="{Binding IsAssemblyMode, Converter={StaticResource BoolToVisibility}}"/>

        <TextBlock Grid.Row="5" Text="Road section" Visibility="{Binding IsProfileMode, Converter={StaticResource BoolToVisibility}}"/>
        <ComboBox Grid.Row="5" Grid.Column="1"
                  Visibility="{Binding IsProfileMode, Converter={StaticResource BoolToVisibility}}"
                  ItemsSource="{Binding ProfileTypes}"
                  DisplayMemberPath="Name"
                  SelectedItem="{Binding SelectedProfileType}"/>

        <TextBlock Grid.Row="6" Grid.ColumnSpan="2" Text="{Binding ProfileStatus}" TextWrapping="Wrap"
                   Visibility="{Binding IsProfileMode, Converter={StaticResource BoolToVisibility}}"/>

        <CheckBox Grid.Row="7" Grid.ColumnSpan="2" Content="Flip section left to right" IsChecked="{Binding MirrorProfile}"
                  Visibility="{Binding IsProfileMode, Converter={StaticResource BoolToVisibility}}"/>

        <TextBlock Grid.Row="8" Text="Units"/>
        <ComboBox Grid.Row="8" Grid.Column="1"
                  ItemsSource="{Binding DisplayUnits}"
                  DisplayMemberPath="Label"
                  SelectedValue="{Binding SelectedDisplayUnit, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Grid.Row="9" Text="Section spacing"/>
        <TextBox Grid.Row="9" Grid.Column="1" HorizontalContentAlignment="Right"
                 Text="{Binding Interval, UpdateSourceTrigger=PropertyChanged, Converter={behaviours:NumericText}}"
                 MaxLength="12" behaviours:TextBoxInput.RegularExpression="^[0-9]*[.,]?[0-9]*$"
                 ToolTip="Distance between sections along the alignment. Curves and changes of grade get extra sections."/>

        <TextBlock Grid.Row="10" Text="Vertical offset"/>
        <TextBox Grid.Row="10" Grid.Column="1" HorizontalContentAlignment="Right"
                 Text="{Binding VerticalOffset, UpdateSourceTrigger=PropertyChanged, Converter={behaviours:NumericText}}"
                 MaxLength="12" behaviours:TextBoxInput.RegularExpression="^-?[0-9]*[.,]?[0-9]*$"
                 ToolTip="Raises (positive) or lowers (negative) the whole road relative to the alignment's profile."/>

        <TextBlock Grid.Row="11" Text="Category" Visibility="{Binding ShowCategory, Converter={StaticResource BoolToVisibility}}"/>
        <ComboBox Grid.Row="11" Grid.Column="1"
                  Visibility="{Binding ShowCategory, Converter={StaticResource BoolToVisibility}}"
                  ItemsSource="{Binding Categories}"
                  DisplayMemberPath="Name"
                  SelectedItem="{Binding SelectedCategory}"/>

        <TextBlock Grid.Row="12" Text="Geometry"/>
        <ComboBox Grid.Row="12" Grid.Column="1"
                  ItemsSource="{Binding GeometryMethods}"
                  DisplayMemberPath="Name"
                  SelectedItem="{Binding SelectedGeometryMethod}"
                  ToolTip="Segmented loft makes a solid between each pair of sections, so every section shows as a line. Smooth surfaces make continuous faces along the road; if Revit can't, the segmented loft is used."/>

        <TextBlock Grid.Row="13" Text="Create as" Visibility="{Binding IsProfileMode, Converter={StaticResource BoolToVisibility}}"/>
        <ComboBox Grid.Row="13" Grid.Column="1" Visibility="{Binding IsProfileMode, Converter={StaticResource BoolToVisibility}}"
                  ItemsSource="{Binding Outputs}"
                  DisplayMemberPath="Name"
                  SelectedItem="{Binding SelectedOutput}"
                  ToolTip="A direct shape is plain geometry. A family is loaded into the project with a type you can see in the Project Browser. Toposolid only adds no road at all: the swept geometry is only used to make a toposolid that follows its top surface."/>

        <TextBlock Grid.Row="14" Text="Toposolid type" Visibility="{Binding IsToposolidOutput, Converter={StaticResource BoolToVisibility}}"/>
        <ComboBox Grid.Row="14" Grid.Column="1"
                  Visibility="{Binding IsToposolidOutput, Converter={StaticResource BoolToVisibility}}"
                  ItemsSource="{Binding ToposolidTypes}"
                  DisplayMemberPath="Name"
                  SelectedItem="{Binding SelectedToposolidType}"
                  ToolTip="The type sets the thickness and layers of the toposolid, which hangs below the road surface."/>

        <TextBlock Grid.Row="15" Text="Level" Visibility="{Binding IsToposolidOutput, Converter={StaticResource BoolToVisibility}}"/>
        <ComboBox Grid.Row="15" Grid.Column="1"
                  Visibility="{Binding IsToposolidOutput, Converter={StaticResource BoolToVisibility}}"
                  ItemsSource="{Binding Levels}"
                  DisplayMemberPath="Name"
                  SelectedItem="{Binding SelectedLevel}"/>

        <CheckBox Grid.Row="16" Grid.ColumnSpan="2" Content="Grade the topo out from the sides"
                  IsChecked="{Binding GradeTopo}"
                  Visibility="{Binding ShowGradeTopo, Converter={StaticResource BoolToVisibility}}"
                  ToolTip="Runs a cut or fill slope from each side of the assembly to the ground, using the slopes set in the assembly, and reshapes the toposolid to match."/>

        <Button Grid.Row="17" Grid.ColumnSpan="2" Content="Pick toposolids" Command="{Binding PickToposolidCommand}"
                ToolTip="Pick every toposolid to grade. Each side of the road changes the toposolids its slope reaches, so there can be a different one either side."
                Visibility="{Binding ShowGradeTopoPick, Converter={StaticResource BoolToVisibility}}"/>

        <TextBlock Grid.Row="18" Grid.ColumnSpan="2" Text="{Binding GradeTopoStatus}" TextWrapping="Wrap"
                   Visibility="{Binding ShowGradeTopo, Converter={StaticResource BoolToVisibility}}"/>

        <TextBlock Grid.Row="19" Grid.ColumnSpan="2" Text="{Binding ExistingRoadNote}" TextWrapping="Wrap"/>

        <Button Grid.Row="20" Grid.ColumnSpan="2" Content="{Binding CreateButtonText}" IsDefault="True" Height="30"
                Command="{Binding CreateCommand}"/>
    </Grid>
</Window>
