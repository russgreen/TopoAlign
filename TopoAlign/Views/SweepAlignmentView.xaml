<Window x:Class="TopoAlign.Views.SweepAlignmentView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:TopoAlign.ViewModels"
        xmlns:behaviours="clr-namespace:TopoAlign.Behaviours"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance {x:Type viewModels:SweepAlignmentViewModel}, IsDesignTimeCreatable=False}"
        Title="{Binding WindowTitle}"
        FontSize="12" FontFamily="Segoe UI Light"
        WindowStartupLocation="CenterScreen"
        SizeToContent="Height" Width="420"
        WindowStyle="ToolWindow" ResizeMode="NoResize">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.Resources>
            <Style TargetType="TextBlock">
                <Setter Property="Margin" Value="0,0,0,6"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style TargetType="TextBox">
                <Setter Property="Margin" Value="0,0,0,6"/>
                <Setter Property="Height" Value="20"/>
            </Style>
            <Style TargetType="ComboBox">
                <Setter Property="Margin" Value="0,0,0,6"/>
            </Style>
            <Style TargetType="CheckBox">
                <Setter Property="Margin" Value="0,0,0,6"/>
            </Style>
            <Style TargetType="Button">
                <Setter Property="Margin" Value="0,0,0,6"/>
                <Setter Property="Height" Value="25"/>
            </Style>
        </Grid.Resources>

        <Button Grid.Row="0" Grid.ColumnSpan="2" Content="Pick alignment" Command="{Binding PickAlignmentCommand}"/>

        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding AlignmentStatus}" TextWrapping="Wrap"/>

        <TextBlock Grid.Row="2" Text="Road section"/>
        <ComboBox Grid.Row="2" Grid.Column="1"
                  ItemsSource="{Binding ProfileTypes}"
                  DisplayMemberPath="Name"
                  SelectedItem="{Binding SelectedProfileType}"/>

        <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="{Binding ProfileStatus}" TextWrapping="Wrap"/>

        <CheckBox Grid.Row="4" Grid.ColumnSpan="2" Content="Flip section left to right" IsChecked="{Binding MirrorProfile}"/>

        <TextBlock Grid.Row="5" Text="Units"/>
        <ComboBox Grid.Row="5" Grid.Column="1"
                  ItemsSource="{Binding DisplayUnits}"
                  DisplayMemberPath="Label"
                  SelectedValue="{Binding SelectedDisplayUnit, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Grid.Row="6" Text="Section spacing"/>
        <TextBox Grid.Row="6" Grid.Column="1" HorizontalContentAlignment="Right"
                 Text="{Binding Interval, UpdateSourceTrigger=PropertyChanged}"
                 MaxLength="12" behaviours:TextBoxInput.RegularExpression="^[0-9]*[.,]?[0-9]*$"
                 ToolTip="Distance between sections along the alignment. Curves and changes of grade get extra sections."/>

        <TextBlock Grid.Row="7" Text="Vertical offset"/>
        <TextBox Grid.Row="7" Grid.Column="1" HorizontalContentAlignment="Right"
                 Text="{Binding VerticalOffset, UpdateSourceTrigger=PropertyChanged}"
                 MaxLength="12" behaviours:TextBoxInput.RegularExpression="^-?[0-9]*[.,]?[0-9]*$"
                 ToolTip="Raises (positive) or lowers (negative) the whole road relative to the alignment's profile."/>

        <TextBlock Grid.Row="8" Text="Category"/>
        <ComboBox Grid.Row="8" Grid.Column="1"
                  ItemsSource="{Binding Categories}"
                  DisplayMemberPath="Name"
                  SelectedItem="{Binding SelectedCategory}"/>

        <TextBlock Grid.Row="9" Text="Geometry"/>
        <ComboBox Grid.Row="9" Grid.Column="1"
                  ItemsSource="{Binding GeometryMethods}"
                  DisplayMemberPath="Name"
                  SelectedItem="{Binding SelectedGeometryMethod}"
                  ToolTip="Segmented loft makes a solid between each pair of sections, so every section shows as a line. Smooth surfaces make continuous faces along the road; if Revit can't, the segmented loft is used."/>

        <TextBlock Grid.Row="10" Text="Create as"/>
        <ComboBox Grid.Row="10" Grid.Column="1"
                  ItemsSource="{Binding Outputs}"
                  DisplayMemberPath="Name"
                  SelectedItem="{Binding SelectedOutput}"
                  ToolTip="A direct shape is plain geometry. A family is loaded into the project with a type you can see in the Project Browser."/>

        <TextBlock Grid.Row="11" Grid.ColumnSpan="2" Text="{Binding ExistingRoadNote}" TextWrapping="Wrap"/>

        <Button Grid.Row="12" Grid.ColumnSpan="2" Content="Create Road" IsDefault="True" Height="30"
                Command="{Binding CreateCommand}"/>
    </Grid>
</Window>
