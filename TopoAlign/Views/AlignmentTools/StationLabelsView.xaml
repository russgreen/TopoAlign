<Window x:Class="TopoAlign.Views.AlignmentTools.StationLabelsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vmAlignmentTools="clr-namespace:TopoAlign.ViewModels.AlignmentTools"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance {x:Type vmAlignmentTools:StationLabelsViewModel}, IsDesignTimeCreatable=False}"
        Title="{Binding WindowTitle}"
        FontSize="12" FontFamily="Segoe UI Light"
        WindowStartupLocation="CenterScreen"
        SizeToContent="Height" Width="400"
        WindowStyle="ToolWindow" ResizeMode="NoResize">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.Resources>
            <Style TargetType="TextBlock">
                <Setter Property="Margin" Value="0,0,0,6"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style TargetType="TextBox">
                <Setter Property="Margin" Value="0,0,0,6"/>
                <Setter Property="Height" Value="20"/>
                <Setter Property="HorizontalContentAlignment" Value="Right"/>
            </Style>
            <Style TargetType="ComboBox">
                <Setter Property="Margin" Value="0,0,0,6"/>
            </Style>
            <Style TargetType="CheckBox">
                <Setter Property="Margin" Value="0,0,0,6"/>
            </Style>
            <Style TargetType="Button">
                <Setter Property="Margin" Value="0,0,0,6"/>
                <Setter Property="Height" Value="25"/>
            </Style>
        </Grid.Resources>

        <Button Grid.Row="0" Grid.ColumnSpan="2" Content="Pick alignment" Command="{Binding PickAlignmentCommand}"/>

        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding AlignmentStatus}" TextWrapping="Wrap"/>

        <TextBlock Grid.Row="2" Text="Label type"/>
        <ComboBox Grid.Row="2" Grid.Column="1"
                  ItemsSource="{Binding LabelTypes}"
                  DisplayMemberPath="Name"
                  SelectedItem="{Binding SelectedLabelType}"/>

        <TextBlock Grid.Row="3" Text="Units"/>
        <ComboBox Grid.Row="3" Grid.Column="1"
                  ItemsSource="{Binding DisplayUnits}"
                  DisplayMemberPath="Label"
                  SelectedValue="{Binding SelectedDisplayUnit, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Grid.Row="4" Text="Interval"/>
        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding IntervalText, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="Distance between labels. Leave blank for the default (100 ft or 1000 m)."/>

        <TextBlock Grid.Row="5" Text="Offset (paper)"/>
        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding OffsetText, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="Distance from the alignment on the sheet. Positive is to the right, negative to the left. Leave blank for the default."/>

        <TextBlock Grid.Row="6" Text="From station"/>
        <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding StartStationText, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="Leave blank to start at the start of the alignment."/>

        <TextBlock Grid.Row="7" Text="To station"/>
        <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding EndStationText, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="Leave blank to end at the end of the alignment."/>

        <CheckBox Grid.Row="8" Grid.ColumnSpan="2" Content="Leader line" IsChecked="{Binding HasLeader}"/>

        <TextBlock Grid.Row="9" Grid.ColumnSpan="2" Text="{Binding ViewStatus}" TextWrapping="Wrap"/>

        <TextBlock Grid.Row="10" Grid.ColumnSpan="2" Text="{Binding InputMessage}" TextWrapping="Wrap" Foreground="#B00020"/>

        <Button Grid.Row="11" Grid.ColumnSpan="2" Content="Create Labels" IsDefault="True" Height="30"
                Command="{Binding CreateCommand}"/>
    </Grid>
</Window>
