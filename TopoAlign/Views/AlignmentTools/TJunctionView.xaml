<Window x:Class="TopoAlign.Views.AlignmentTools.TJunctionView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vmAlignmentTools="clr-namespace:TopoAlign.ViewModels.AlignmentTools"
        xmlns:behaviours="clr-namespace:TopoAlign.Behaviours"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance {x:Type vmAlignmentTools:TJunctionViewModel}, IsDesignTimeCreatable=False}"
        Title="{Binding WindowTitle}"
        FontSize="12" FontFamily="Segoe UI Light"
        WindowStartupLocation="CenterScreen"
        SizeToContent="Height" Width="420"
        WindowStyle="ToolWindow" ResizeMode="NoResize">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.Resources>
            <Style TargetType="TextBlock">
                <Setter Property="Margin" Value="0,0,0,6"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style TargetType="TextBox">
                <Setter Property="Margin" Value="0,0,0,6"/>
                <Setter Property="Height" Value="20"/>
                <Setter Property="HorizontalContentAlignment" Value="Right"/>
            </Style>
            <Style TargetType="ComboBox">
                <Setter Property="Margin" Value="0,0,0,6"/>
            </Style>
            <Style TargetType="CheckBox">
                <Setter Property="Margin" Value="0,0,0,6"/>
            </Style>
            <Style TargetType="Button">
                <Setter Property="Margin" Value="0,0,0,6"/>
                <Setter Property="Height" Value="25"/>
            </Style>
        </Grid.Resources>

        <Button Grid.Row="0" Grid.ColumnSpan="2" Content="Pick main road alignment" Command="{Binding PickMainCommand}"/>
        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding MainStatus}" TextWrapping="Wrap"/>

        <Button Grid.Row="2" Grid.ColumnSpan="2" Content="Pick side road alignment" Command="{Binding PickSideCommand}"/>
        <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="{Binding SideStatus}" TextWrapping="Wrap"/>

        <Grid Grid.Row="4" Grid.ColumnSpan="2" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Margin="0" Content="Pick main road element (optional)" Command="{Binding PickMainRoadCommand}"
                    IsEnabled="{Binding HasMain}"
                    ToolTip="Pick the element that models the main road surface. The kerb levels are then read from its geometry instead of the alignment profile, so crossfall is picked up."/>
            <Button Grid.Column="1" Margin="6,0,0,0" Padding="8,0" Content="Clear" Command="{Binding ClearMainRoadCommand}"/>
        </Grid>
        <TextBlock Grid.Row="5" Grid.ColumnSpan="2" Text="{Binding RoadStatus}" TextWrapping="Wrap"/>

        <TextBlock Grid.Row="6" Text="Units"/>
        <ComboBox Grid.Row="6" Grid.Column="1"
                  ItemsSource="{Binding DisplayUnits}"
                  DisplayMemberPath="Label"
                  SelectedValue="{Binding SelectedDisplayUnit, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Grid.Row="7" Text="Kerb radius"/>
        <TextBox Grid.Row="7" Grid.Column="1"
                 Text="{Binding KerbRadius, UpdateSourceTrigger=PropertyChanged, Converter={behaviours:NumericText}}"
                 MaxLength="12" behaviours:TextBoxInput.RegularExpression="^[0-9]*[.,]?[0-9]*$"
                 ToolTip="Radius of the kerb returns."/>

        <TextBlock Grid.Row="8" Text="Side road half-width"/>
        <TextBox Grid.Row="8" Grid.Column="1"
                 Text="{Binding SideHalfWidth, UpdateSourceTrigger=PropertyChanged, Converter={behaviours:NumericText}}"
                 MaxLength="12" behaviours:TextBoxInput.RegularExpression="^[0-9]*[.,]?[0-9]*$"
                 ToolTip="Distance from the side road centreline to its kerb. Use 0 to fillet between the centrelines."/>

        <TextBlock Grid.Row="9" Text="Main road half-width"/>
        <TextBox Grid.Row="9" Grid.Column="1"
                 Text="{Binding MainHalfWidth, UpdateSourceTrigger=PropertyChanged, Converter={behaviours:NumericText}}"
                 MaxLength="12" behaviours:TextBoxInput.RegularExpression="^[0-9]*[.,]?[0-9]*$"
                 ToolTip="Distance from the main road centreline to its kerb. Use 0 to fillet between the centrelines."/>

        <TextBlock Grid.Row="10" Text="Main kerb level offset"/>
        <TextBox Grid.Row="10" Grid.Column="1"
                 Text="{Binding MainLevelOffset, UpdateSourceTrigger=PropertyChanged, Converter={behaviours:NumericText}}"
                 MaxLength="12" behaviours:TextBoxInput.RegularExpression="^-?[0-9]*[.,]?[0-9]*$"
                 ToolTip="Added to the main road level at the kerb returns (after any picked road element). Negative values lower the kerbs."/>
        <TextBlock Grid.Row="11" Grid.ColumnSpan="2" Text="{Binding LevelReadout}" TextWrapping="Wrap"/>

        <CheckBox Grid.Row="12" Grid.ColumnSpan="2" Content="Use the other end of the side road" IsChecked="{Binding UseOtherEnd}"
                  ToolTip="When both ends of the side road reach the main road, join the farther one instead of the nearer one."/>

        <CheckBox Grid.Row="13" Grid.ColumnSpan="2" Content="Create road surface at the junction" IsChecked="{Binding CreateSurface}"
                  ToolTip="Makes the road surface where the roads meet, as a separate piece of geometry."/>

        <TextBlock Grid.Row="14" Text="Surface thickness"/>
        <TextBox Grid.Row="14" Grid.Column="1" IsEnabled="{Binding CreateSurface}"
                 Text="{Binding SurfaceThickness, UpdateSourceTrigger=PropertyChanged, Converter={behaviours:NumericText}}"
                 MaxLength="12" behaviours:TextBoxInput.RegularExpression="^[0-9]*[.,]?[0-9]*$"
                 ToolTip="Thickness of the road surface, measured down from its top."/>

        <CheckBox Grid.Row="15" Grid.ColumnSpan="2" Content="Cut the junction out of the main road" IsChecked="{Binding CutMainRoad}"
                  ToolTip="Removes the parts of the main road's geometry (kerbs, footways and so on) that fall inside the junction, so the junction can take their place. Needs a road made by TopoAlign along the main alignment."/>

        <CheckBox Grid.Row="16" Grid.ColumnSpan="2" Content="Trim or extend the side road to the junction" IsChecked="{Binding JoinSideRoad}"
                  ToolTip="Cuts the side road's geometry back to where the junction surface begins, or extends it up to there if it stops short. Needs a road made by TopoAlign along the side alignment."/>

        <TextBlock Grid.Row="17" Grid.ColumnSpan="2" Text="{Binding ResultMessage}" TextWrapping="Wrap" Foreground="#B00020"/>

        <Button Grid.Row="18" Grid.ColumnSpan="2" Content="Create T-Junction" IsDefault="True" Height="30"
                Command="{Binding CreateCommand}"/>
    </Grid>
</Window>
