<Window x:Class="TopoAlign.Views.RoadTools.AssemblyEditorView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vmRoadTools="clr-namespace:TopoAlign.ViewModels.RoadTools"
        xmlns:behaviours="clr-namespace:TopoAlign.Behaviours"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance {x:Type vmRoadTools:AssemblyEditorViewModel}, IsDesignTimeCreatable=False}"
        Title="Road assemblies"
        FontSize="12" FontFamily="Segoe UI Light"
        WindowStartupLocation="CenterScreen"
        Width="1040" Height="660" MinWidth="820" MinHeight="520"
        WindowStyle="ToolWindow" ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Height" Value="25"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- choosing an assembly -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Saved assemblies" Margin="0,0,8,0"/>
            <ComboBox Grid.Column="1" ItemsSource="{Binding AssemblyNames}" SelectedItem="{Binding SelectedAssemblyName}"/>
            <Button Grid.Column="2" Content="New" Margin="8,0,6,0" Command="{Binding NewAssemblyCommand}"/>
            <Button Grid.Column="3" Content="Delete" Command="{Binding DeleteAssemblyCommand}"/>
            <TextBlock Grid.Column="5" Text="Units" Margin="0,0,8,0"/>
            <ComboBox Grid.Column="6" ItemsSource="{Binding DisplayUnits}" DisplayMemberPath="Label"
                      SelectedValue="{Binding SelectedDisplayUnit, UpdateSourceTrigger=PropertyChanged}"/>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Assembly name" Margin="0,0,8,0"/>
            <TextBox Grid.Column="1" Height="22" VerticalContentAlignment="Center"
                     Text="{Binding AssemblyName, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="The name the assembly is saved and listed under."/>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.35*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*" MinWidth="260"/>
            </Grid.ColumnDefinitions>

            <!-- the parts -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DataGrid x:Name="PartsGrid" ItemsSource="{Binding Parts}" SelectedItem="{Binding SelectedPart, Mode=TwoWay}"
                          AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False"
                          CanUserReorderColumns="False" HeadersVisibility="Column" SelectionMode="Single" SelectionUnit="FullRow"
                          GridLinesVisibility="Horizontal" RowHeaderWidth="0" Margin="0,0,0,8">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Part" Width="*" MinWidth="90"
                                            Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>

                        <DataGridTemplateColumn Header="Profile" Width="1.6*" MinWidth="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox BorderThickness="0" Background="Transparent"
                                              ItemsSource="{Binding DataContext.ProfileTypes, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              DisplayMemberPath="Name"
                                              SelectedItem="{Binding SelectedProfile, UpdateSourceTrigger=PropertyChanged}"
                                              ToolTip="The profile family type swept for this part."/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- The numeric converter remembers what was typed, so the editing box and the display text each need their
                             own binding: sharing one converter between them leaves the displayed text blank after an edit. -->
                        <DataGridTemplateColumn Header="Lateral offset" Width="85">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock HorizontalAlignment="Right" Padding="2,0"
                                               Text="{Binding LateralOffset, StringFormat=0.###}"
                                               ToolTip="Across the road from the alignment: positive to the right of the direction of travel, negative to the left."/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <TextBox HorizontalContentAlignment="Right" BorderThickness="0" MaxLength="12"
                                             Text="{Binding LateralOffset, UpdateSourceTrigger=PropertyChanged, Converter={behaviours:NumericText}}"
                                             behaviours:TextBoxInput.RegularExpression="^-?[0-9]*[.,]?[0-9]*$"
                                             Loaded="NumericEditor_Loaded"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Vertical offset" Width="85">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock HorizontalAlignment="Right" Padding="2,0"
                                               Text="{Binding VerticalOffset, StringFormat=0.###}"
                                               ToolTip="Up (positive) or down (negative) from the alignment's finished level."/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <TextBox HorizontalContentAlignment="Right" BorderThickness="0" MaxLength="12"
                                             Text="{Binding VerticalOffset, UpdateSourceTrigger=PropertyChanged, Converter={behaviours:NumericText}}"
                                             behaviours:TextBoxInput.RegularExpression="^-?[0-9]*[.,]?[0-9]*$"
                                             Loaded="NumericEditor_Loaded"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <DataGridCheckBoxColumn Header="Mirror" Width="55"
                                                Binding="{Binding MirrorProfile, UpdateSourceTrigger=PropertyChanged}"/>

                        <DataGridTemplateColumn Header="Category" Width="*" MinWidth="95">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox BorderThickness="0" Background="Transparent"
                                              ItemsSource="{Binding DataContext.Categories, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              DisplayMemberPath="Name"
                                              SelectedItem="{Binding SelectedCategory, UpdateSourceTrigger=PropertyChanged}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="1" Orientation="Horizontal">
                    <Button Content="Add part" Command="{Binding AddPartCommand}"/>
                    <Button Content="Remove" Command="{Binding RemovePartCommand}"/>
                    <Button Content="Move up" Command="{Binding MoveUpCommand}"/>
                    <Button Content="Move down" Command="{Binding MoveDownCommand}"/>
                </StackPanel>
            </Grid>

            <!-- the picture -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border BorderBrush="#FFBBBBBB" BorderThickness="1" Background="White" ClipToBounds="True">
                    <Canvas x:Name="PreviewCanvas" SizeChanged="PreviewCanvas_SizeChanged" ClipToBounds="True"/>
                </Border>
                <TextBlock Grid.Row="1" Text="{Binding Warning}" Foreground="#FFB05A00" TextWrapping="Wrap" Margin="0,6,0,0"/>
            </Grid>
        </Grid>

        <!-- grading the ground out from the sides -->
        <GroupBox Grid.Row="3" Header="Grade the topo out from the sides" Margin="0,8,0,0" Padding="6"
                  Visibility="{Binding CanGradeTopo, Converter={StaticResource BoolToVisibility}}"
                  ToolTip="When a toposolid is picked in Sweep Along Alignment, a slope runs from the outer edge of the assembly until it meets the ground: the cut slope where the ground is above the edge, the fill slope where it is below.">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="160"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Column="1" Text="Grade" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="2" Text="Cut slope" FontWeight="SemiBold"
                           ToolTip="Used where the ground is above the edge. 1 : 2 is entered as 2 in Ratio."/>
                <TextBlock Grid.Column="3" Text="Fill slope" FontWeight="SemiBold"
                           ToolTip="Used where the ground is below the edge."/>
                <TextBlock Grid.Column="4" Text="Max width" FontWeight="SemiBold"
                           ToolTip="Furthest the slope may run, measured square to the alignment, in the units chosen above."/>
                <TextBlock Grid.Column="6" Text="Slope as" Margin="0,0,8,0"/>
                <ComboBox Grid.Column="7" Grid.Row="0" ItemsSource="{Binding SlopeModes}" DisplayMemberPath="Label"
                          SelectedItem="{Binding SelectedSlopeMode}"/>

                <TextBlock Grid.Row="1" Text="Left" Margin="0,6,0,0"/>
                <CheckBox Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Margin="0,6,0,0"
                          IsChecked="{Binding LeftGrading.Enabled}"/>
                <TextBox Grid.Row="1" Grid.Column="2" Margin="0,6,6,0" IsEnabled="{Binding LeftGrading.Enabled}"
                         Text="{Binding LeftGrading.CutValue, UpdateSourceTrigger=PropertyChanged}"
                         behaviours:TextBoxInput.RegularExpression="^[0-9]*[.]?[0-9]*$"/>
                <TextBox Grid.Row="1" Grid.Column="3" Margin="0,6,6,0" IsEnabled="{Binding LeftGrading.Enabled}"
                         Text="{Binding LeftGrading.FillValue, UpdateSourceTrigger=PropertyChanged}"
                         behaviours:TextBoxInput.RegularExpression="^[0-9]*[.]?[0-9]*$"/>
                <TextBox Grid.Row="1" Grid.Column="4" Margin="0,6,6,0" IsEnabled="{Binding LeftGrading.Enabled}"
                         Text="{Binding LeftGrading.MaxWidth, UpdateSourceTrigger=PropertyChanged}"
                         behaviours:TextBoxInput.RegularExpression="^[0-9]*[.]?[0-9]*$"/>

                <TextBlock Grid.Row="2" Text="Right" Margin="0,6,0,0"/>
                <CheckBox Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Margin="0,6,0,0"
                          IsChecked="{Binding RightGrading.Enabled}"/>
                <TextBox Grid.Row="2" Grid.Column="2" Margin="0,6,6,0" IsEnabled="{Binding RightGrading.Enabled}"
                         Text="{Binding RightGrading.CutValue, UpdateSourceTrigger=PropertyChanged}"
                         behaviours:TextBoxInput.RegularExpression="^[0-9]*[.]?[0-9]*$"/>
                <TextBox Grid.Row="2" Grid.Column="3" Margin="0,6,6,0" IsEnabled="{Binding RightGrading.Enabled}"
                         Text="{Binding RightGrading.FillValue, UpdateSourceTrigger=PropertyChanged}"
                         behaviours:TextBoxInput.RegularExpression="^[0-9]*[.]?[0-9]*$"/>
                <TextBox Grid.Row="2" Grid.Column="4" Margin="0,6,6,0" IsEnabled="{Binding RightGrading.Enabled}"
                         Text="{Binding RightGrading.MaxWidth, UpdateSourceTrigger=PropertyChanged}"
                         behaviours:TextBoxInput.RegularExpression="^[0-9]*[.]?[0-9]*$"/>
            </Grid>
        </GroupBox>

        <TextBlock Grid.Row="4" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#FF555555"
                   Text="Offsets are measured from the alignment: lateral is positive to the right of the direction of travel, vertical is up from the finished level. Tick Mirror to flip a profile left to right, for example a kerb drawn for the left of the road used on the right."/>

        <Grid Grid.Row="5" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Save" Width="80" Command="{Binding SaveCommand}"/>
                <Button Content="Close" Width="80" Margin="0" IsCancel="True" Command="{Binding CloseCommand}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
