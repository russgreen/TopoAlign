<Window x:Class="TopoAlign.Views.ResetTopoView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:TopoAlign.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance {x:Type viewModels:ResetTopoViewModel}, IsDesignTimeCreatable=False}"
        Title="{Binding WindowTitle}"
        FontSize="12" FontFamily="Segoe UI Light"
        WindowStartupLocation="CenterScreen"
        Height="215" Width="360"
        WindowStyle="ToolWindow" ResizeMode="NoResize">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="20"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Source topo surface"/>
        <ComboBox Grid.Row="1" Margin="0,0,0,5"
                  ItemsSource="{Binding SourceTopos}"
                  DisplayMemberPath="Label"
                  SelectedItem="{Binding SelectedSource}"/>

        <TextBlock Grid.Row="2" Text="Target topo surface"/>
        <ComboBox Grid.Row="3" Margin="0,0,0,5"
                  ItemsSource="{Binding TargetTopos}"
                  DisplayMemberPath="Label"
                  SelectedItem="{Binding SelectedTarget}"/>

        <Button Grid.Row="4" Content="Reset topo region" IsDefault="True"
                Width="197" HorizontalAlignment="Right" Margin="0,5,0,0"
                Command="{Binding OkCommand}" />
    </Grid>
</Window>
