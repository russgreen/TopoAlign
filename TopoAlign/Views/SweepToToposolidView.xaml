<Window x:Class="TopoAlign.Views.SweepToToposolidView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:TopoAlign.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance {x:Type viewModels:SweepToToposolidViewModel}, IsDesignTimeCreatable=False}"
        Title="{Binding WindowTitle}"
        FontSize="12" FontFamily="Segoe UI Light"
        WindowStartupLocation="CenterScreen"
        SizeToContent="Height" Width="420"
        WindowStyle="ToolWindow" ResizeMode="NoResize">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.Resources>
            <Style TargetType="TextBlock">
                <Setter Property="Margin" Value="0,0,0,6"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style TargetType="ComboBox">
                <Setter Property="Margin" Value="0,0,0,6"/>
            </Style>
            <Style TargetType="CheckBox">
                <Setter Property="Margin" Value="0,0,0,6"/>
            </Style>
            <Style TargetType="Button">
                <Setter Property="Margin" Value="0,0,0,6"/>
                <Setter Property="Height" Value="25"/>
            </Style>
        </Grid.Resources>

        <Button Grid.Row="0" Grid.ColumnSpan="2" Content="Pick road" Command="{Binding PickRoadCommand}"/>

        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding RoadStatus}" TextWrapping="Wrap"/>

        <TextBlock Grid.Row="2" Text="Toposolid type"/>
        <ComboBox Grid.Row="2" Grid.Column="1"
                  ItemsSource="{Binding ToposolidTypes}"
                  DisplayMemberPath="Name"
                  SelectedItem="{Binding SelectedType}"
                  ToolTip="The type sets the thickness and layers of the toposolid, which hangs below the road surface."/>

        <TextBlock Grid.Row="3" Text="Level"/>
        <ComboBox Grid.Row="3" Grid.Column="1"
                  ItemsSource="{Binding Levels}"
                  DisplayMemberPath="Name"
                  SelectedItem="{Binding SelectedLevel}"/>

        <CheckBox Grid.Row="4" Grid.ColumnSpan="2" Content="Delete the original road" IsChecked="{Binding DeleteRoad}"
                  ToolTip="Removes the swept road once the toposolid has been made. A road made as a family is deleted with its family."/>

        <TextBlock Grid.Row="5" Grid.ColumnSpan="2" Text="{Binding StatusNote}" TextWrapping="Wrap"/>

        <Button Grid.Row="6" Grid.ColumnSpan="2" Content="Create Toposolid" IsDefault="True" Height="30"
                Command="{Binding CreateCommand}"/>
    </Grid>
</Window>
