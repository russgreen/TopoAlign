<Window x:Class="TopoAlign.Views.KerbView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:TopoAlign.ViewModels"
        xmlns:behaviours="clr-namespace:TopoAlign.Behaviours"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance {x:Type viewModels:KerbViewModel}, IsDesignTimeCreatable=False}"
        Title="{Binding WindowTitle}"
        FontSize="12" FontFamily="Segoe UI Light"
        WindowStartupLocation="CenterScreen"
        SizeToContent="Height" Width="420"
        WindowStyle="ToolWindow" ResizeMode="NoResize">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.Resources>
            <Style TargetType="TextBlock">
                <Setter Property="Margin" Value="0,0,0,6"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style TargetType="TextBox">
                <Setter Property="Margin" Value="0,0,0,6"/>
                <Setter Property="Height" Value="20"/>
            </Style>
            <Style TargetType="ComboBox">
                <Setter Property="Margin" Value="0,0,0,6"/>
            </Style>
            <Style TargetType="CheckBox">
                <Setter Property="Margin" Value="0,0,0,6"/>
            </Style>
            <Style TargetType="Button">
                <Setter Property="Margin" Value="0,0,0,6"/>
                <Setter Property="Height" Value="25"/>
            </Style>
        </Grid.Resources>

        <Button Grid.Row="0" Content="Pick edges" Command="{Binding PickEdgesCommand}" Margin="0,0,3,6"
                ToolTip="Click edges of toposolids, floors, roads or any other element. Picks are added to the ones already made."/>
        <Button Grid.Row="0" Grid.Column="1" Content="Pick model lines" Command="{Binding PickLinesCommand}" Margin="3,0,0,6"
                ToolTip="Click model lines or arcs. Picks are added to the ones already made."/>

        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding PickStatus}" TextWrapping="Wrap"/>

        <Button Grid.Row="2" Grid.ColumnSpan="2" Content="Clear picks" Command="{Binding ClearPicksCommand}"/>

        <TextBlock Grid.Row="3" Text="Kerb profile"/>
        <ComboBox Grid.Row="3" Grid.Column="1"
                  ItemsSource="{Binding ProfileTypes}"
                  DisplayMemberPath="Name"
                  SelectedItem="{Binding SelectedProfileType}"/>

        <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Text="{Binding ProfileStatus}" TextWrapping="Wrap"/>

        <CheckBox Grid.Row="5" Grid.ColumnSpan="2" Content="Flip profile left to right" IsChecked="{Binding FlipProfile}"
                  ToolTip="The profile's origin sits on the edge and its right-hand side (positive X) goes to the right of the direction of travel. A closed loop runs anticlockwise, so the right is the outside."/>

        <TextBlock Grid.Row="6" Text="Units"/>
        <ComboBox Grid.Row="6" Grid.Column="1"
                  ItemsSource="{Binding DisplayUnits}"
                  DisplayMemberPath="Label"
                  SelectedValue="{Binding SelectedDisplayUnit, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Grid.Row="7" Text="Section spacing"/>
        <TextBox Grid.Row="7" Grid.Column="1" HorizontalContentAlignment="Right"
                 Text="{Binding Interval, UpdateSourceTrigger=PropertyChanged}"
                 MaxLength="12" behaviours:TextBoxInput.RegularExpression="^[0-9]*[.,]?[0-9]*$"
                 ToolTip="Longest distance between sections along a curved edge. Straight edges only get a section at each end."/>

        <TextBlock Grid.Row="8" Text="Vertical offset"/>
        <TextBox Grid.Row="8" Grid.Column="1" HorizontalContentAlignment="Right"
                 Text="{Binding VerticalOffset, UpdateSourceTrigger=PropertyChanged}"
                 MaxLength="12" behaviours:TextBoxInput.RegularExpression="^-?[0-9]*[.,]?[0-9]*$"
                 ToolTip="Raises (positive) or lowers (negative) the whole kerb relative to the edges."/>

        <TextBlock Grid.Row="9" Text="Category"/>
        <ComboBox Grid.Row="9" Grid.Column="1"
                  ItemsSource="{Binding Categories}"
                  DisplayMemberPath="Name"
                  SelectedItem="{Binding SelectedCategory}"/>

        <TextBlock Grid.Row="10" Text="Create as"/>
        <ComboBox Grid.Row="10" Grid.Column="1"
                  ItemsSource="{Binding Outputs}"
                  DisplayMemberPath="Name"
                  SelectedItem="{Binding SelectedOutput}"
                  ToolTip="A direct shape is plain geometry. A family is loaded into the project with a type you can see in the Project Browser."/>

        <CheckBox Grid.Row="11" Grid.ColumnSpan="2" Content="Show the kerb and ask before keeping it" IsChecked="{Binding ReviewBeforeKeeping}"
                  ToolTip="The kerb is built in the model and selected, then you choose to keep it, flip it to the other side of the edges, or cancel."/>

        <Button Grid.Row="12" Grid.ColumnSpan="2" Content="Create Kerb" IsDefault="True" Height="30"
                Command="{Binding CreateCommand}"/>
    </Grid>
</Window>
