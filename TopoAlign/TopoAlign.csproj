<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	  <Configurations>Debug R21;Debug R22;Debug R23;Debug R24;Debug R25;Debug R26;Debug R27</Configurations>
	  <Configurations>$(Configurations);Release R21;Release R22;Release R23;Release R24;Release R25;Release R26;Release R27</Configurations>
	  <Description>Align topo surface to model elements</Description>
	  <Copyright>Copyright © Russell Green</Copyright>
	  <Version>3.6.0</Version>
	  <PlatformTarget>x64</PlatformTarget>
	  <RuntimeIdentifier>win-x64</RuntimeIdentifier>
	  <LangVersion>latest</LangVersion>
	  <ImplicitUsings>enable</ImplicitUsings>
	  <NeutralLanguage>en</NeutralLanguage>
	  <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
	  <UseWPF>true</UseWPF>
	  <Nullable>enable</Nullable>
	  <!--<UseWindowsForms>true</UseWindowsForms>-->
	  <!--<ImplicitUsings>true</ImplicitUsings>-->
	  <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
	  <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
	  <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
	  <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

	<PropertyGroup Condition="$(Configuration.Contains('Debug'))">
		<DebugSymbols>true</DebugSymbols>
		<DebugType>full</DebugType>
		<DefineConstants>$(DefineConstants);DEBUG</DefineConstants>
	</PropertyGroup>
	<PropertyGroup Condition="$(Configuration.Contains('Release'))">
		<Optimize>true</Optimize>
		<DebugType>none</DebugType>
		<DefineConstants>$(DefineConstants);RELEASE</DefineConstants>		
	</PropertyGroup>

	<PropertyGroup Condition="$(Configuration.Contains('R21'))">
		<TargetFramework>net48</TargetFramework>
		<RevitVersion>2021</RevitVersion>
		<DefineConstants>$(DefineConstants);REVIT2021</DefineConstants>
		<DefineConstants>$(DefineConstants);REVIT2019_OR_GREATER;REVIT2020_OR_GREATER;REVIT2021_OR_GREATER</DefineConstants>
	</PropertyGroup>
	<PropertyGroup Condition="$(Configuration.Contains('R22'))">
		<TargetFramework>net48</TargetFramework>
		<RevitVersion>2022</RevitVersion>
		<DefineConstants>$(DefineConstants);REVIT2022</DefineConstants>
		<DefineConstants>$(DefineConstants);REVIT2019_OR_GREATER;REVIT2020_OR_GREATER;REVIT2021_OR_GREATER;REVIT2022_OR_GREATER</DefineConstants>
	</PropertyGroup>
	<PropertyGroup Condition="$(Configuration.Contains('R23'))">
		<TargetFramework>net48</TargetFramework>
		<RevitVersion>2023</RevitVersion>
		<DefineConstants>$(DefineConstants);REVIT2023</DefineConstants>
		<DefineConstants>$(DefineConstants);REVIT2019_OR_GREATER;REVIT2020_OR_GREATER;REVIT2021_OR_GREATER;REVIT2022_OR_GREATER;REVIT2023_OR_GREATER</DefineConstants>
	</PropertyGroup>
	<PropertyGroup Condition="$(Configuration.Contains('R24'))">
		<TargetFramework>net48</TargetFramework>
		<RevitVersion>2024</RevitVersion>
		<DefineConstants>$(DefineConstants);REVIT2024</DefineConstants>
		<DefineConstants>$(DefineConstants);REVIT2019_OR_GREATER;REVIT2020_OR_GREATER;REVIT2021_OR_GREATER;REVIT2022_OR_GREATER;REVIT2023_OR_GREATER;REVIT2024_OR_GREATER</DefineConstants>
	</PropertyGroup>
	<PropertyGroup Condition="$(Configuration.Contains('R25'))">
		<TargetFramework>net10.0-windows</TargetFramework>
		<RevitVersion>2025</RevitVersion>
		<DefineConstants>$(DefineConstants);REVIT2025</DefineConstants>
		<DefineConstants>$(DefineConstants);REVIT2019_OR_GREATER;REVIT2020_OR_GREATER;REVIT2021_OR_GREATER;REVIT2022_OR_GREATER;REVIT2023_OR_GREATER;REVIT2024_OR_GREATER;REVIT2025_OR_GREATER</DefineConstants>
	</PropertyGroup>
	<PropertyGroup Condition="$(Configuration.Contains('R26'))">
		<TargetFramework>net10.0-windows</TargetFramework>
		<RevitVersion>2026</RevitVersion>
		<DefineConstants>$(DefineConstants);REVIT2026</DefineConstants>
		<DefineConstants>$(DefineConstants);REVIT2019_OR_GREATER;REVIT2020_OR_GREATER;REVIT2021_OR_GREATER;REVIT2022_OR_GREATER;REVIT2023_OR_GREATER;REVIT2024_OR_GREATER;REVIT2025_OR_GREATER;REVIT2026_OR_GREATER</DefineConstants>
	</PropertyGroup>	
	<PropertyGroup Condition="$(Configuration.Contains('R27'))">
		<TargetFramework>net10.0-windows</TargetFramework>
		<RevitVersion>2027</RevitVersion>
		<DefineConstants>$(DefineConstants);REVIT2027</DefineConstants>
		<DefineConstants>$(DefineConstants);REVIT2019_OR_GREATER;REVIT2020_OR_GREATER;REVIT2021_OR_GREATER;REVIT2022_OR_GREATER;REVIT2023_OR_GREATER;REVIT2024_OR_GREATER;REVIT2025_OR_GREATER;REVIT2026_OR_GREATER;REVIT2027_OR_GREATER</DefineConstants>
	</PropertyGroup>

	<PropertyGroup>
		<AssemblyName>TopoAlign</AssemblyName>
	</PropertyGroup>
	
	<PropertyGroup>
		<IsRepackable Condition="$(Configuration.Contains('Release'))">true</IsRepackable>
		<!--<RepackBinariesExcludes>Syncfusion*.dll</RepackBinariesExcludes>-->
	</PropertyGroup>

	<ItemGroup>
	  <Compile Remove="Enums\**" />
	  <EmbeddedResource Remove="Enums\**" />
	  <None Remove="Enums\**" />
	  <Page Remove="Enums\**" />
	</ItemGroup>
     
  
   <ItemGroup>
     <None Remove="Images\FloorToTopo32.png" />
     <None Remove="Images\PointsFromContours32.png" />
     <None Remove="Images\PointsFromLines32.png" />
     <None Remove="Images\Reset32.png" />
     <None Remove="Images\TopoAlign32.png" />
     <None Remove="Images\TopoAlignPlane32.png" />
     <None Remove="Images\AlignmentFromCurve32.png" />
     <None Remove="Images\EditAlignment32.png" />
     <None Remove="Images\SweepAlongAlignment32.png" />
     <None Remove="Images\StationLabels32.png" />
     <None Remove="Images\EditProfile32.png" />
     <None Remove="Images\SweepToToposolid32.png" />
     <None Remove="Images\GradeToSurface32.png" />
     <None Remove="Images\AlignTopoEdges32.png" />
     <None Remove="Images\Kerb32.png" />
     <None Remove="Images\DroppedKerbRamp32.png" />
   </ItemGroup>

   <!-- Toposolids arrived in Revit 2024, so the Sweep to Toposolid dialog is only built from there. -->
   <ItemGroup Condition="$(RevitVersion) &lt; 2024">
     <Page Remove="Views\RoadTools\SweepToToposolidView.xaml" />
     <Compile Remove="Views\RoadTools\SweepToToposolidView.xaml.cs" />
     <Page Remove="Views\GradingTools\GradeToSurfaceView.xaml" />
     <Compile Remove="Views\GradingTools\GradeToSurfaceView.xaml.cs" />
     <Page Remove="Views\GradingTools\KerbRampView.xaml" />
     <Compile Remove="Views\GradingTools\KerbRampView.xaml.cs" />
   </ItemGroup>
  
   <ItemGroup>
     <EmbeddedResource Include="Images\FloorToTopo32.png" />
     <EmbeddedResource Include="Images\PointsFromContours32.png" />
     <EmbeddedResource Include="Images\PointsFromLines32.png" />
     <EmbeddedResource Include="Images\Reset32.png" />
     <EmbeddedResource Include="Images\TopoAlign32.png" />
     <EmbeddedResource Include="Images\TopoAlignPlane32.png" />
     <EmbeddedResource Include="Images\AlignmentFromCurve32.png" />
     <EmbeddedResource Include="Images\EditAlignment32.png" />
     <EmbeddedResource Include="Images\SweepAlongAlignment32.png" />
     <EmbeddedResource Include="Images\StationLabels32.png" />
     <EmbeddedResource Include="Images\EditProfile32.png" />
     <EmbeddedResource Include="Images\SweepToToposolid32.png" />
     <EmbeddedResource Include="Images\GradeToSurface32.png" />
     <EmbeddedResource Include="Images\AlignTopoEdges32.png" />
     <EmbeddedResource Include="Images\Kerb32.png" />
     <EmbeddedResource Include="Images\DroppedKerbRamp32.png" />
   </ItemGroup>
  
   <ItemGroup>
	 <PackageReference Include="CommunityToolkit.Mvvm" Version="8.*" />
	 <PackageReference Include="geometry3Sharp" Version="1.0.324" />
	 <PackageReference Include="System.Text.Json" Version="10.0.14" Condition="'$(TargetFramework)'=='net48'" />
	 <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).*" />
	 <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).*" />
	 <PackageReference Include="Nice3point.Revit.Extensions" Version="$(RevitVersion).*" />

	 <PackageReference Include="Serilog" Version="4.4.0" />

	 <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
	 <PackageReference Include="Serilog.Sinks.GoogleAnalytics" Version="1.*" />

	   <!--Repacking-->
	   <PackageReference Include="ILRepack" Version="2.0.48">
		   <PrivateAssets>all</PrivateAssets>
		   <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
	   </PackageReference>
   </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TopoAlign.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Update="TopoAlign.addin">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <SubType>Designer</SubType>
    </None>
  </ItemGroup>

</Project>
